# --- Lexicanum bot + build_index.py ---
DISCORD_TOKEN=bot-token-buraya                    # lexicanum.py, build_index.py
DISCORD_BOT_TOKEN_WH40K=                          # build_server.py / dump_all.py (boşsa DISCORD_TOKEN'a düşer)

# --- build_server.py (filmarchive) ---
NMDB_MAIN=/path/nmdb_arsiv.db
NMDB_DISC=/path/nmdb_arsiv_discoveries.db
WORK=./work                                      # state/plan/trash/backup dizini
FILM_GUILD_ID=1552514539344363610                # hedef guild (override)

# --- dump_all.py ---
WH40K_GUILD_ID=1551561397031407626               # wh40k hedef guild
DISCORD_GUILD_ID=                                # genel guild override
DISCORD_REPO=/path/Discord                       # repo kökü (varsayılan: script konumundan türetilir)

# --- güvenlik ---
DRY_RUN=                                         # 1/true/yes: POST/PATCH/DELETE yalnız loglanır
